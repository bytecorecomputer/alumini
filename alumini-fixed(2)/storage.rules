rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // 1. Allow public read access (essential for QR codes, profile pics, certificates)
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. Certificates: Only admins can upload
    match /certificates/{fileName} {
      allow write: if isAdmin();
    }

    // 3. Profile Photos: Authenticated users can upload to their OWN folder
    match /students/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId && 
                   request.resource.size < 5 * 1024 * 1024 && // Max 5MB
                   request.resource.contentType.matches('image/.*');
    }
    // Also allow admins to upload for any student
    match /students/{allPaths=**} {
      allow write: if isAdmin();
    }

    // 4. General fallback: Deny anything not explicitly allowed
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
