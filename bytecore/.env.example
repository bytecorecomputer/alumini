SESSION_SECRET=long-random-text
# Admin login = your existing Firebase email/password (role admin in Firestore users/{uid}).
# Defaults are your current Firebase web key + project; set only if you changed them:
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=practice-be58e
# Optional: override the two Google Sheet CSV links
# SHEET_NARIYAWAL=
# SHEET_THIRIYA=
# Instant sheet updates (see apps-script/Code.gs): secret for /api/sync + live sheet URLs
# SYNC_SECRET=another-long-random-text
# SHEET_NARIYAWAL_LIVE=https://script.google.com/macros/s/XXXX/exec?key=SECRET&gid=0
# SHEET_THIRIYA_LIVE=https://script.google.com/macros/s/YYYY/exec?key=SECRET&gid=967039806
